# Copy to .env and fill in. .env is gitignored.

# Rapsodo Cloud login (cloud.rapsodo.com/login)
RAPSODO_EMAIL=
RAPSODO_PASSWORD=

# Optional: paste a JWT directly instead of logging in.
# Grab with: copy(localStorage.getItem('dcv3_token')) in the DevTools console.
# Lives 30 days.
RAPSODO_TOKEN=

# Destination Postgres (the Player Dev / Railway instance)
DATABASE_URL=

# Direct `python rapsodo/daily.py` defaults to 3 days when this is unset.
# `python nightly.py` uses 7 in that case. Set it to pin both.
# RAPSODO_LOOKBACK_DAYS=7

# Read by nightly.py, not by daily.py. Days without a Rapsodo session or a
# newly landed file before the overnight subject becomes ATTENTION.
# Unset means lookback + 2 (9 when the overnight lookback is 7).
# RAPSODO_STALE_AFTER_DAYS=9
