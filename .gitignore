__pycache__/
*.pyc
.env

# Local player-development database. Production uses Railway Postgres via
# DATABASE_URL; this file only exists when running the hub on your machine.
playerdev.db
*.db

# Rapsodo pipeline: cached session token, raw API archive, derived CSVs.
# The raw payloads also go into raw_imports, which is what survives a redeploy --
# Railway's filesystem does not.
token.json
raw/
out/

# Blast CSV exports a coach drops in before running blast/load_export.py. Ignored
# for the same reason raw/ is: ingest keeps the whole file in raw_imports, which is
# the copy that survives a redeploy, so the working file is a scratch input rather
# than a source artefact. It also keeps a 2 MB export per week out of a public repo.
# The LOADER (blast/load_export.py) is tracked -- only the data here is not.
blast/exports/

# NOTE: railway.json is deliberately NOT ignored here -- `railway up` honours
# .gitignore, so listing it would strip the deploy config out of the upload.
# It is excluded from git via .git/info/exclude instead, which keeps it out of
# commits (and so out of any future merge to main) while still shipping.

# Playwright screenshots + HTML dumps from blast/pull_export.py failures.
# Can contain a login screen with the account email; never commit.
blast/diagnostics/
